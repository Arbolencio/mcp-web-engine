# Optional template; select explicitly with MCP_WEB_ENGINE_ENV_FILE=/absolute/path/to/file.
# Process variables override file values; Compose separately interpolates its own .env.
# For --serve, generate API_KEY: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
API_KEY=
SEARXNG_URL=http://127.0.0.1:8082/search
ALLOW_DDG_FALLBACK=false
PORT=5050
HOST=127.0.0.1
RATE_LIMIT_PER_MINUTE=120
DEFAULT_TIMEOUT_SEC=10.0
MAX_PAYLOAD_BYTES=2097152
# HTTP process-local in-flight request ceiling and absolute body-read deadline:
MAX_CONCURRENT_REQUESTS=16
REQUEST_BODY_TIMEOUT_SEC=10
LOG_LEVEL=INFO
ENV=production
# Optional absolute writable paths (defaults: current user's state directory):
# MCP_WEB_ENGINE_STATE_DB=/absolute/path/usage.sqlite3
# MCP_WEB_ENGINE_BETA_KEYS_FILE=/absolute/path/beta_keys.json
